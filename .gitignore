# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# local CSV exports (generated per run)
data/exports/*.csv

# Python virtualenv + caches for the LSL marker bridge / session logger /
# analyzer. Each lab machine creates its own; nothing here is portable.
python/.venv/
python/__pycache__/
**/__pycache__/
*.pyc

# EEG session outputs — recordings stay on the lab machine, not in git.
python/sessions/
*.edf
*.fif

